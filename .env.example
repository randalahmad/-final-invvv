# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/innovation_platform?schema=public"

# Auth.js (v5) — generate with: npx auth secret   (or) openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
# Required for self-hosted deployments after validating the upstream Host header
# at the reverse proxy/load balancer. Also required by `next start` on localhost.
AUTH_TRUST_HOST="true"

# Stakeholder UX review only. Ignored when VERCEL_ENV=production.
# UX_PREVIEW_MODE="true"

# Optional rate-limit tuning. Counters are stored in PostgreSQL and shared
# across instances. RATE_LIMIT_HASH_SECRET defaults to AUTH_SECRET.
# RATE_LIMIT_HASH_SECRET=""
# RATE_LIMIT_LOGIN_MAX_ATTEMPTS="5"
# RATE_LIMIT_LOGIN_WINDOW_SECONDS="900"
# RATE_LIMIT_REGISTRATION_MAX_ATTEMPTS="3"
# RATE_LIMIT_REGISTRATION_WINDOW_SECONDS="3600"

# Optional: base URL for callbacks (usually auto-detected in dev / on Vercel)
# AUTH_URL="http://localhost:3000"

# Seed admin (production): set these before running the seed on a cloud DB.
# If SEED_ADMIN_PASSWORD is omitted in production, a random one is generated
# and printed once by `npm run db:seed`.
# SEED_ADMIN_EMAIL="admin@yourdomain.sa"
# SEED_ADMIN_PASSWORD="choose-a-strong-password"

# Future: Microsoft Entra ID (Azure AD) SSO — leave empty until enabled
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# ── Evidence object storage (Phase 5A.1) ──────────────────────────────────
# Driver: "s3" (AWS S3 / Cloudflare R2 / MinIO) or "memory" (dev/test only).
# Omit to auto-detect: S3 when S3_BUCKET is set, otherwise memory in
# development. In production an unconfigured driver fails fast.
# STORAGE_DRIVER="s3"
# S3_BUCKET="innovation-evidence"
# S3_REGION="auto"                       # "auto" for Cloudflare R2
# S3_ENDPOINT=""                          # R2/MinIO endpoint; empty for AWS S3
# S3_ACCESS_KEY_ID=""                     # omit to use the ambient IAM chain
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"            # "true" for MinIO

# Redirect downloads to a short-lived pre-signed URL instead of streaming.
# STORAGE_USE_SIGNED_URLS="false"
# STORAGE_SIGNED_URL_TTL_SECONDS="120"   # clamped to 30…900

# Per-file upload ceiling in megabytes (default 25).
# EVIDENCE_MAX_FILE_MB="25"
