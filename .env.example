# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/innovation_platform?schema=public"

# Auth.js (v5) — generate with: npx auth secret   (or) openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
# Required for self-hosted deployments after validating the upstream Host header
# at the reverse proxy/load balancer. Also required by `next start` on localhost.
AUTH_TRUST_HOST="true"

# Stakeholder UX review only. Ignored when VERCEL_ENV=production.
# UX_PREVIEW_MODE="true"

# Opt-in only, local dev convenience: an in-app "quick switch account"
# topbar shortcut (off by default -- this project uses real, separate
# per-account login instead; see DEMO_MODE below). Leave unset.
# DEV_ROLE_SWITCHER="true"

# Preview-only AI readiness check for innovator idea/project documents.
# Vercel deployments may use OIDC; local development can use a Gateway API key.
# AI_GATEWAY_API_KEY=""
# AI_READINESS_MODEL="openai/gpt-6-luna"

# Explicit database-free demo mode for local development or non-production
# previews. UX_PREVIEW_MODE takes precedence when both are true. Demo mode is
# always disabled in Production; a missing DATABASE_URL then fails safely.
# DEMO_MODE="true"

# Optional rate-limit tuning. Counters are stored in PostgreSQL and shared
# across instances. RATE_LIMIT_HASH_SECRET defaults to AUTH_SECRET.
# RATE_LIMIT_HASH_SECRET=""
# RATE_LIMIT_LOGIN_MAX_ATTEMPTS="5"
# RATE_LIMIT_LOGIN_WINDOW_SECONDS="900"
# RATE_LIMIT_REGISTRATION_MAX_ATTEMPTS="3"
# RATE_LIMIT_REGISTRATION_WINDOW_SECONDS="3600"

# Optional: base URL for callbacks (usually auto-detected in dev / on Vercel)
# AUTH_URL="http://localhost:3000"

# Seed admin (production): set these before running the seed on a cloud DB.
# If SEED_ADMIN_PASSWORD is omitted in production, a random one is generated
# and printed once by `npm run db:seed`.
# SEED_ADMIN_EMAIL="admin@yourdomain.sa"
# SEED_ADMIN_PASSWORD="choose-a-strong-password"

# Future: Microsoft Entra ID (Azure AD) SSO — leave empty until enabled
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# ── Evidence object storage (Phase 5A.1) ──────────────────────────────────
# Driver: "s3" (AWS S3 / Cloudflare R2 / MinIO) or "memory" (dev/test only).
# Omit to auto-detect: S3 when S3_BUCKET is set, otherwise memory in
# development. In production an unconfigured driver fails fast.
# STORAGE_DRIVER="s3"
# S3_BUCKET="innovation-evidence"
# S3_REGION="auto"                       # "auto" for Cloudflare R2
# S3_ENDPOINT=""                          # R2/MinIO endpoint; empty for AWS S3
# S3_ACCESS_KEY_ID=""                     # omit to use the ambient IAM chain
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"            # "true" for MinIO

# Redirect downloads to a short-lived pre-signed URL instead of streaming.
# STORAGE_USE_SIGNED_URLS="false"
# STORAGE_SIGNED_URL_TTL_SECONDS="120"   # clamped to 30…900

# Per-file upload ceiling in megabytes (default 25).
# EVIDENCE_MAX_FILE_MB="25"


# -- Idea AI screening (advisory only) --------------------------------------
# When an idea is submitted, an initial AI-based screening runs against a
# fixed set of criteria (completeness, strategic alignment, feasibility
# signal, possible duplicate, risk flags) using an external AI model. This is
# ADVISORY ONLY: it never sets Idea.status and never writes an
# IdeaEvaluation/IdeaDecision row -- a human reviewer always makes the real
# call. If no provider key below is set, screening fails gracefully and idea
# submission still succeeds.
#
# Default transport: Vercel's AI Gateway, reusing the SAME key as the
# "AI readiness" preview feature above (AI_GATEWAY_API_KEY) -- no separate
# account needed. Optionally pick a different Gateway model id:
# IDEA_SCREENING_MODEL="anthropic/claude-sonnet-4-5"
#
# Fallback transport: a direct Anthropic call, used only if AI_GATEWAY_API_KEY
# is unset but ANTHROPIC_API_KEY is set.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"
# ANTHROPIC_API_BASE_URL="https://api.anthropic.com"
#
# Caution (data residency): idea content is sent to an external AI model,
# outside KSA/KACARE-controlled infrastructure. Sending real institutional
# idea content to it needs sign-off -- see docs/document-analysis.md section 8
# and docs/technical-decisions.md T7 before enabling this in a non-demo
# environment.
