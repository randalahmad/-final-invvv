# Dedicated stakeholder demo database. Copy to .env.demo and adjust credentials.
# Never point this file at innovation_platform or a production database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/innovation_demo?schema=public"

AUTH_SECRET="replace-with-a-long-random-demo-secret"
AUTH_TRUST_HOST="true"
STORAGE_DRIVER="memory"

# Optional demo credential overrides
# SEED_ADMIN_EMAIL="admin@innovation.local"
# SEED_ADMIN_PASSWORD="Admin@12345"
# SEED_DEMO_PASSWORD="Demo@12345"
